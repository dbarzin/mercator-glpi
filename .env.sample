APP_NAME="Mercator GLPI Connector"
APP_ENV=production
APP_DEBUG=false

# ── GLPI ──────────────────────────────────────────────────────────────────────
GLPI_URL=http://localhost:8080

# Version de l'API GLPI : v2 (GLPI 11+, OAuth2 — défaut) ou v1 (API legacy apirest.php, GLPI 10)
GLPI_API_VERSION=v2

# API v2 : client OAuth (Configuration > Clients OAuth, grant "Mot de passe",
# scopes "api" + "graphql") et compte GLPI dédié au connecteur
GLPI_CLIENT_ID=your_oauth_client_id_here
GLPI_CLIENT_SECRET=your_oauth_client_secret_here
GLPI_USERNAME=svc-mercator
GLPI_PASSWORD=your_password_here
GLPI_OAUTH_SCOPE="api graphql"

# API v1 uniquement (GLPI_API_VERSION=v1)
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=

# Entité GLPI à synchroniser (vide = toutes les entités)
GLPI_ENTITY_ID=

# Filtrage par statut GLPI (states_id) — IDs séparés par virgules ; vide = tous
GLPI_ALLOWED_STATES=
GLPI_ALLOWED_STATES_COMPUTERS=
GLPI_ALLOWED_STATES_PHONES=
GLPI_ALLOWED_STATES_PERIPHERALS=
GLPI_ALLOWED_STATES_NETWORK_EQUIPMENT=
GLPI_ALLOWED_STATES_RACKS=

# Routage des Computer par sous-type (IDs ou noms de computertypes GLPI)
# Vide = tous les Computer ; pour logical_servers/physical_servers vide = désactivé
GLPI_COMPUTER_TYPES_WORKSTATIONS=
GLPI_COMPUTER_TYPES_LOGICAL_SERVERS=
GLPI_COMPUTER_TYPES_PHYSICAL_SERVERS=

# Routage des NetworkEquipment par sous-type (IDs ou noms de networkequipmenttypes GLPI)
# Vide pour SWITCHES = tous les NetworkEquipment non routés ailleurs (comportement historique)
# Vide pour les autres = désactivé (opt-in explicite)
GLPI_NETWORK_DEVICE_TYPES_SWITCHES=
GLPI_NETWORK_DEVICE_TYPES_ROUTERS=
GLPI_NETWORK_DEVICE_TYPES_WIFI_TERMINALS=
GLPI_NETWORK_DEVICE_TYPES_PHYSICAL_SECURITY_DEVICES=
GLPI_NETWORK_DEVICE_TYPES_STORAGE_DEVICES=

# Routage des Appliance GLPI (services numériques) : "activities" (défaut, historique) ou
# "applications" / Route GLPI Appliances (digital services) to: "activities" (default) or "applications"
# Toute autre valeur retombe sur "activities". Attention : Software et Appliance ciblant
# tous deux "applications" fusionnent par nom homonyme (fallback ext_refs), cf. README.
GLPI_APPLIANCE_MERCATOR_ENDPOINT=activities

# Filtrage des Domain par type (IDs ou noms de domaintypes GLPI) — vide = tous types acceptés
GLPI_DOMAIN_TYPES=

# Filtrage des Software par catégorie (IDs ou noms de softwarecategories GLPI) — vide = toutes catégories acceptées
GLPI_SOFTWARE_CATEGORIES=

# ── Mercator ──────────────────────────────────────────────────────────────────
MERCATOR_URL=http://localhost:8000
MERCATOR_LOGIN=admin@admin.com
MERCATOR_PASSWORD=password

# Périmètre Mercator de cette synchronisation : seuls les objets de ce périmètre sont
# réconciliés, mis à jour et nettoyés ; les objets créés y sont rangés. Vide = le
# connecteur ne gère pas le périmètre (défaut Mercator à la création, inchangé à la
# mise à jour). Surchargé par l'option --perimeter. Plusieurs instances GLPI : un
# périmètre ET un compte Mercator dédiés par instance (cf. README).
MERCATOR_PERIMETER_ID=

# Import des liens serveur logique (VM) → serveur(s) physique(s) hôte(s), via les
# entrées de machine virtuelle GLPI (ItemVirtualMachine / ComputerVirtualMachine).
# Opt-in : nécessite GLPI_COMPUTER_TYPES_LOGICAL_SERVERS et
# GLPI_COMPUTER_TYPES_PHYSICAL_SERVERS configurés. Écrase à chaque run les liens
# manuels des serveurs logiques déjà tagués {GLPI} dans Mercator (voir README).
GLPI_SYNC_VM_LINKS=true

# Ne synchroniser que les bases de données actives (glpi_databases.is_active=1) — opt-in
GLPI_SYNC_ONLY_ACTIVE_DATABASES=false

# ── Synchronisation ───────────────────────────────────────────────────────────
SYNC_DRY_RUN=false

# ── Logs ──────────────────────────────────────────────────────────────────────
# Niveaux : debug, info, warning, error
# En mode debug, les URLs, payloads et réponses HTTP complètes sont journalisés.
LOG_LEVEL=info
